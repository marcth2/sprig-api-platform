# VERSION — committed to the repository, not a secrets file.
#
# Single source of truth for application and API version numbers.
# Loaded in config/app.php — overrides nothing, only sets what .env does not define.
#
# Versioning policy (semver):
#   Major (1.x.x → 2.0.0)  breaking API contract change; X-API-Version header bumps (v1 → v2)
#   Minor (1.0.x → 1.1.0)  new endpoints or response fields, backwards-compatible
#   Patch (1.0.0 → 1.0.1)  bug fixes, no contract change

APP_VERSION=1.0.0
API_VERSION=${APP_VERSION}
