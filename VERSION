# VERSION — committed to the repository, not a secrets file.
#
# Single source of truth for application and API version numbers.
# Loaded in config/app.php — overrides nothing, only sets what .env does not define.
#
# API_VERSION is derived from APP_VERSION (see #70) via phpdotenv interpolation:
# bumping APP_VERSION's major segment bumps the API contract major version served
# over X-API-Version / the Accept header (config/api.php's supported_versions) too.
# Override with a literal value here on the day they need to diverge.
#
# Versioning policy for APP_VERSION (semver):
#   Major (1.x.x → 2.0.0)  a deliberate decision that the API is a stable public contract
#   Minor (1.0.x → 1.1.0)  a wayfinder's worth of change, pre-1.0
#   Patch (1.0.0 → 1.0.1)  out-of-band bug fixes between wayfinders

APP_VERSION=0.2.0
API_VERSION=${APP_VERSION}
