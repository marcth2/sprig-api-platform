<?xml version="1.0"?>
<ruleset name="sprig-api-platform">
    <description>Line-length gate only — Pint's laravel preset already owns style; full PSR-12 would fight it.</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
